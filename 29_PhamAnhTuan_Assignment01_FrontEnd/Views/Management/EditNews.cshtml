@model NewsFormModel
@{ ViewData["Title"] = "Edit news"; }
<h1 class="h3">Edit news</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="NewsArticleId" type="hidden" /><div class="mb-2"><label asp-for="NewsTitle"></label><input asp-for="NewsTitle" class="form-control" /></div><div class="mb-2"><label asp-for="Headline"></label><input asp-for="Headline" class="form-control" /></div><div class="mb-2"><label asp-for="NewsContent"></label><textarea asp-for="NewsContent" class="form-control" rows="5"></textarea></div><div class="mb-2"><label asp-for="NewsSource"></label><input asp-for="NewsSource" class="form-control" /></div><div class="mb-3"><label asp-for="CategoryId"></label><input asp-for="CategoryId" class="form-control" /></div><div class="form-check mb-3"><input asp-for="NewsStatus" class="form-check-input" /><label asp-for="NewsStatus" class="form-check-label">Active</label></div><button class="btn btn-primary">Save</button></form>
