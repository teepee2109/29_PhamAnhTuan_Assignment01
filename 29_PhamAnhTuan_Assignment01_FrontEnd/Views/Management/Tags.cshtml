@model IReadOnlyList<TagViewModel>
@{ ViewData["Title"] = "Tags"; }
<div class="d-flex justify-content-between mb-3"><h1 class="h3">Tag management</h1><a class="btn btn-primary" asp-action="CreateTag">Create</a></div><form class="input-group mb-3"><input name="search" class="form-control" placeholder="Search tag" /><button class="btn btn-outline-secondary">Search</button></form><table class="table table-bordered"><thead><tr><th>ID</th><th>Name</th><th>Note</th><th></th></tr></thead><tbody>@foreach (var t in Model) { <tr><td>@t.TagId</td><td>@t.TagName</td><td>@t.Note</td><td><form asp-action="DeleteTag" method="post" onsubmit="return confirm('Delete this tag?')"><input type="hidden" name="id" value="@t.TagId" /><button class="btn btn-sm btn-danger">Delete</button></form></td></tr> }</tbody></table>
