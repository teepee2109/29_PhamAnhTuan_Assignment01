@model AccountFormModel
@{ ViewData["Title"] = "Create account"; }
<h1 class="h3">Create account</h1><form asp-action="CreateAccount" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-2"><label asp-for="AccountName"></label><input asp-for="AccountName" class="form-control" /></div><div class="mb-2"><label asp-for="AccountEmail"></label><input asp-for="AccountEmail" class="form-control" /></div><div class="mb-2"><label asp-for="AccountPassword"></label><input asp-for="AccountPassword" class="form-control" /></div><div class="mb-3"><label asp-for="AccountRole"></label><select asp-for="AccountRole" class="form-select"><option value="1">Staff</option><option value="2">Lecturer</option></select></div><button class="btn btn-primary">Save</button></form>
