@model IReadOnlyList<NewsArticleViewModel>
@{ ViewData["Title"] = "Home Page"; }
<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h1 class="display-6">FU News Management</h1><p class="text-muted mb-0">Latest active news</p></div>
    @if (Context.Session.GetString("UserEmail") is null) { <a class="btn btn-primary" asp-controller="Auth" asp-action="Login">Login</a> }
</div>
@if (ViewBag.ApiUnavailable == true) { <div class="alert alert-warning">Backend API chưa được khởi động.</div> }
else if (Model.Count == 0) { <div class="alert alert-info">Chưa có news active.</div> }
else { <div class="row g-3">@foreach (var news in Model) { <div class="col-md-6"><article class="card h-100 shadow-sm"><div class="card-body"><h2 class="h5">@news.NewsTitle</h2><p class="text-muted small">@news.CreatedDate?.ToString("dd/MM/yyyy")</p><p>@news.Headline</p><p class="mb-0">@news.NewsContent</p></div></article></div> }</div> }
